# ──────────────────────────────────────────────
#  CCA Frontend — Environment Variables (Vite)
#  All variables MUST be prefixed with VITE_
#  to be accessible in the browser via:
#  import.meta.env.VITE_VARIABLE_NAME
# ──────────────────────────────────────────────

# Backend API base URL
VITE_API_URL=http://192.168.0.118:3001

# Time Attendance System URL — the "Go to Time Attendance" link on the login page
# points here. Change the IP/port to bind a different machine, or leave blank to
# hide the link entirely.
VITE_TIME_ATTENDANCE_URL=http://192.168.0.118:5180